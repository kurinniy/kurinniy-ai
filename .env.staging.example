APP_ENV=staging
APP_RUNTIME_MODE=bot
TELEGRAM_BOT_TOKEN=123456789:replace-with-staging-bot-token
APP_TIMEZONE=Europe/Moscow
TELEGRAM_POLLING_TIMEOUT_SECONDS=30
DIGEST_SCHEDULER_POLL_INTERVAL_SECONDS=60
OWNER_TELEGRAM_USER_ID=96445950
ADMIN_TELEGRAM_USER_IDS=96445950

# Legacy fallback for admin ids. Prefer ADMIN_TELEGRAM_USER_IDS.
ALLOWED_TELEGRAM_USER_IDS=

# Use a separate database for staging.
MYSQLHOST=
MYSQLPORT=3306
MYSQLDATABASE=
MYSQLUSER=
MYSQLPASSWORD=

# Optional
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GOOGLE_SERVICE_ACCOUNT_JSON=
# Or mount a local credentials file instead:
GOOGLE_SERVICE_ACCOUNT_FILE=
