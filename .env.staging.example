APP_ENV=staging
TELEGRAM_BOT_TOKEN=123456789:replace-with-staging-bot-token
APP_TIMEZONE=Europe/Moscow
TELEGRAM_POLLING_TIMEOUT_SECONDS=30

# Usually this is the same Telegram account as production, but the bot token
# must be different. Otherwise both workers will fight over getUpdates.
ALLOWED_TELEGRAM_USER_IDS=

# Use a separate database for staging.
MYSQLHOST=
MYSQLPORT=3306
MYSQLDATABASE=
MYSQLUSER=
MYSQLPASSWORD=

# Optional
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
