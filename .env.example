TELEGRAM_BOT_TOKEN=123456789:replace-with-real-token
APP_TIMEZONE=Europe/Moscow
TELEGRAM_POLLING_TIMEOUT_SECONDS=30

# Leave empty for the first boot, then message the bot and use /whoami
# to discover your Telegram user id. After that, lock the bot down:
ALLOWED_TELEGRAM_USER_IDS=

# Option 1: Railway-style discrete variables
MYSQLHOST=
MYSQLPORT=3306
MYSQLDATABASE=
MYSQLUSER=
MYSQLPASSWORD=

# Option 2: single connection URL
# MYSQL_URL=mysql://user:password@host:3306/database
