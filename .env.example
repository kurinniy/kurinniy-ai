APP_ENV=production
APP_RUNTIME_MODE=bot
TELEGRAM_BOT_TOKEN=123456789:replace-with-real-token
APP_TIMEZONE=Europe/Moscow
TELEGRAM_POLLING_TIMEOUT_SECONDS=30
TELEGRAM_FOOD_PHOTO_RATE_LIMIT_SECONDS=15
DIGEST_SCHEDULER_POLL_INTERVAL_SECONDS=7200
OWNER_TELEGRAM_USER_ID=96445950
ADMIN_TELEGRAM_USER_IDS=96445950
MINI_APP_URL=
WEB_HOST=0.0.0.0
WEB_PORT=8000
WEBAPP_SESSION_SECRET=
WEBAPP_SESSION_TTL_SECONDS=86400
WEBAPP_INIT_DATA_TTL_SECONDS=3600

# Legacy fallback for admin ids. Prefer ADMIN_TELEGRAM_USER_IDS.
ALLOWED_TELEGRAM_USER_IDS=

# Option 1: Railway-style discrete variables
MYSQLHOST=
MYSQLPORT=3306
MYSQLDATABASE=
MYSQLUSER=
MYSQLPASSWORD=

# Option 2: single connection URL
# MYSQL_URL=mysql://user:password@host:3306/database

# Optional
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GOOGLE_SERVICE_ACCOUNT_JSON=
# Or mount a local credentials file instead:
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_DRIVE_LOOKBACK_DAYS=2

# Optional Railway Bucket storage for meal photos
BUCKET=
ENDPOINT=
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
BUCKET_KEY_PREFIX=meal-media
